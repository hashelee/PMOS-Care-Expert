# --- Data: never commit raw or processed patient data ---
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# --- Large ultrasound volumes / model weights ---
*.vtk
*.nii
*.nii.gz
*.pt
*.pth
*.ckpt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
